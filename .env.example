# ── Supabase Configuration (Required for Auth & Messaging) ─────────────
# Get these from: Supabase Project -> Settings -> API -> Project URL & Project API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AI Provider (Google Gemini API Key for Chat, Personas & Images) ───
# Get your Gemini API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_gemini_api_key

# ── ChatSorter AI Memory Layer (https://chatsorter.com) ────────────────
# For persistent long-term memory across sessions
CHATSORTER_API_KEY=your_chatsorter_api_key

# ── Optional Fallback (Groq) ───────────────────────────────────────────
# Optional fallback if you want a secondary chat provider (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# ── Server-only secrets (REQUIRED in production as of v5) ──────────────
# Supabase -> Settings -> API -> service_role key. NEVER prefix with NEXT_PUBLIC_.
# Used for plan upgrades and quota enforcement; there is no fallback to the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Payments ───────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhooks are rejected unless signed with these secrets:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Stripe Payment Links (client_reference_id is added automatically)
NEXT_PUBLIC_STRIPE_PLUS_LINK=
NEXT_PUBLIC_STRIPE_PRO_LINK=

# ── Voice lounges: TURN relay (needed for many mobile networks) ────────
# STUN alone fails behind strict NATs. Use any TURN provider (Metered, Cloudflare, coturn...).
NEXT_PUBLIC_TURN_URLS=turn:your.turn.host:3478,turns:your.turn.host:5349?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── Optional ───────────────────────────────────────────────────────────
# Cross-origin callers allowed to use /api/chat and /api/generate-image (default: none, same-origin only)
ALLOWED_ORIGINS=
# Override model cascades without a code change (comma-separated)
GEMINI_CHAT_MODELS_FREE=
GEMINI_CHAT_MODELS_PAID=
GEMINI_IMAGE_MODELS=
